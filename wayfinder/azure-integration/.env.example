# Shared API key protecting every backend route.
# Must match WAYFINDER_API_KEY (agent) and VITE_API_KEY (dashboard).
API_KEY=

# Port to listen on. App Service / Container Apps set this automatically.
PORT=5050

# Comma-separated dashboard origins allowed by CORS, e.g.
# https://<your-app>.azurestaticapps.net. Leave empty only for local development.
CORS_ORIGINS=

# Screenshot storage. With a connection string, screenshots are kept in a
# private blob container (required when deployed). Without one, they are kept
# on local disk in WAYFINDER_SCREENSHOT_DIR (defaults to ../screenshots).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=screenshots
WAYFINDER_SCREENSHOT_DIR=

# Auth
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Cosmos DB
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DB=

# Vision
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Monitor
AZURE_LOG_WORKSPACE=
